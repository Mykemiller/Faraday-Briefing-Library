{
  "name": "faraday-briefing-library",
  "version": "1.0.0",
  "private": true,
  "description": "The Briefing Library storefront \u2014 a token-metered reading room for Faraday's cultivated intelligence.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lanes:run": "node scripts/lanes/run.mjs",
    "lanes:all": "node scripts/lanes/run-all.mjs",
    "lanes:samples": "BL3_REQUIRE_THESIS=0 node scripts/lanes/run-all.mjs --dry-run --emit docs/briefs/samples",
    "render:manuscript": "node scripts/templates/render.mjs --manuscript",
    "review": "node scripts/review/run.mjs",
    "review:fixtures": "node scripts/review/fixtures/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@clerk/nextjs": "^6.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-virtual": "^3.10.8",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
