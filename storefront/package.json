{
  "name": "faraday-briefing-library-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "BL-12: read-only Briefing Library storefront. Reads published briefings with the Supabase anon key only.",
  "scripts": {
    "prebuild": "node scripts/sync-entity-register.mjs",
    "predev": "node scripts/sync-entity-register.mjs",
    "pretest": "node scripts/sync-entity-register.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node scripts/sync-entity-register.mjs && tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
